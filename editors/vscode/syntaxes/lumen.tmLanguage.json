{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lumen",
  "scopeName": "source.lumen",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.lumen", "match": "//.*$" },
        { "name": "comment.block.lumen", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lumen",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.lumen", "match": "\\\\." },
        { "name": "meta.interpolation.lumen", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.lumen", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.lumen", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.float.lumen", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b" },
        { "name": "constant.numeric.integer.lumen", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.lumen", "match": "\\b(if|else|while|for|in|loop|match|return|break|continue|try|step)\\b" },
        { "name": "keyword.declaration.lumen", "match": "\\b(fn|let|var|const|struct|enum|trait|impl|pub|import)\\b" },
        { "name": "constant.language.lumen", "match": "\\b(true|false)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.lumen", "match": "\\b(int|float|bool|string|void)\\b" },
        { "name": "entity.name.type.lumen", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "2": { "name": "entity.name.function.lumen" } } },
        { "name": "support.function.builtin.lumen", "match": "\\b(print|len|push|pop|str|int|float|sqrt|abs|min|max|substr|find|split|join|trim|assert|read_line|at_eof|exit|sort|reverse|contains|slice|floor|ceil|insert|remove|upper|lower|replace|starts_with|ends_with|repeat|parse_int|parse_float|byte|chr|clock|read_file|write_file|append_file|remove_file|http_get|http_request|file_exists|list_dir|env|args)(?=\\()" }
      ]
    }
  }
}
