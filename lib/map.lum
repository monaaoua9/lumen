// string-keyed map. keys and vals keep insertion order, index is a hash table of positions into them
// (bucket count doubles twice over as it fills, delete rebuilds it because positions shift)
pub struct Map<V> { keys: string[], vals: V[], index: int[][] }

fn hash(key: string): int {
  var h = 7;
  for i in 0..len(key) { h = (h * 31 + byte(key, i)) % 1000003; }
  return h;
}

fn rebuild<V>(m: Map<V>, buckets: int) {
  let idx: int[][] = [];
  for _b in 0..buckets {
    let empty: int[] = [];
    push(idx, empty);
  }
  for i, k in m.keys { push(idx[hash(k) % buckets], i); }
  m.index = idx;
}

fn slot<V>(m: Map<V>, key: string): int {
  for i in m.index[hash(key) % len(m.index)] {
    if m.keys[i] == key { return i; }
  }
  return -1;
}

pub fn set<V>(m: Map<V>, key: string, value: V) {
  let at = slot(m, key);
  if at >= 0 {
    m.vals[at] = value;
    return;
  }
  push(m.keys, key);
  push(m.vals, value);
  push(m.index[hash(key) % len(m.index)], len(m.keys) - 1);
  if len(m.keys) > 2 * len(m.index) { rebuild(m, len(m.index) * 4); }
}

pub fn get<V>(m: Map<V>, key: string, fallback: V): V {
  let at = slot(m, key);
  return if at < 0 { fallback } else { m.vals[at] };
}

pub fn has<V>(m: Map<V>, key: string): bool {
  return slot(m, key) >= 0;
}

pub fn delete<V>(m: Map<V>, key: string): bool {
  let at = slot(m, key);
  if at < 0 { return false; }
  remove(m.keys, at);
  remove(m.vals, at);
  rebuild(m, len(m.index));
  return true;
}

pub fn size<V>(m: Map<V>): int {
  return len(m.keys);
}

// copies, so changing the result does not touch the map
pub fn keys<V>(m: Map<V>): string[] {
  let out: string[] = [];
  for k in m.keys { push(out, k); }
  return out;
}

pub fn values<V>(m: Map<V>): V[] {
  let out: V[] = [];
  for v in m.vals { push(out, v); }
  return out;
}

// missing keys start from `start`
pub fn update<V>(m: Map<V>, key: string, start: V, f: fn(V): V) {
  set(m, key, f(get(m, key, start)));
}

// the type comes from the annotation: let m: map.Map<int> = map.new();
pub fn new<V>(): Map<V> {
  let m: Map<V> = Map { keys: [], vals: [], index: [] };
  rebuild(m, 8);
  return m;
}

pub fn entries<V>(m: Map<V>): (string, V)[] {
  let out: (string, V)[] = [];
  for i, k in m.keys { push(out, (k, m.vals[i])); }
  return out;
}

pub fn from_entries<V>(es: (string, V)[]): Map<V> {
  let m: Map<V> = new();
  for (k, v) in es { set(m, k, v); }
  return m;
}

// b wins on shared keys
pub fn merge<V>(a: Map<V>, b: Map<V>): Map<V> {
  let m: Map<V> = new();
  for (k, v) in entries(a) { set(m, k, v); }
  for (k, v) in entries(b) { set(m, k, v); }
  return m;
}
