// proleptic gregorian calendar, days counted from 1970-01-01
pub fn is_leap(y: int): bool {
  return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0);
}

pub fn days_in_month(y: int, m: int): int {
  if m == 2 { return if is_leap(y) { 29 } else { 28 }; }
  if m == 4 || m == 6 || m == 9 || m == 11 { return 30; }
  return 31;
}

// days from civil, after Howard Hinnant's algorithm
pub fn to_days(y: int, m: int, d: int): int {
  let yy = if m <= 2 { y - 1 } else { y };
  let era = (if yy >= 0 { yy } else { yy - 399 }) / 400;
  let yoe = yy - era * 400;
  let mp = (m + 9) % 12;
  let doy = (153 * mp + 2) / 5 + d - 1;
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + doe - 719468;
}

pub fn from_days(days: int): (int, int, int) {
  let z = days + 719468;
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
  let doe = z - era * 146097;
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  let mp = (5 * doy + 2) / 153;
  let d = doy - (153 * mp + 2) / 5 + 1;
  let m = if mp < 10 { mp + 3 } else { mp - 9 };
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 });
  return (y, m, d);
}

// 0 is monday
pub fn weekday(y: int, m: int, d: int): int {
  return ((to_days(y, m, d) + 3) % 7 + 7) % 7;
}

pub fn iso(y: int, m: int, d: int): string {
  let mm = if m < 10 { "0" + str(m) } else { str(m) };
  let dd = if d < 10 { "0" + str(d) } else { str(d) };
  return str(y) + "-" + mm + "-" + dd;
}

pub fn add_days(y: int, m: int, d: int, n: int): (int, int, int) {
  return from_days(to_days(y, m, d) + n);
}
