// higher-order helpers over arrays. none of them change their input
pub fn map<T, U>(xs: T[], f: fn(T): U): U[] {
  let out: U[] = [];
  for x in xs { push(out, f(x)); }
  return out;
}

pub fn filter<T>(xs: T[], keep: fn(T): bool): T[] {
  let out: T[] = [];
  for x in xs {
    if keep(x) { push(out, x); }
  }
  return out;
}

pub fn fold<T, A>(xs: T[], start: A, step: fn(A, T): A): A {
  var acc = start;
  for x in xs { acc = step(acc, x); }
  return acc;
}

pub fn any<T>(xs: T[], test: fn(T): bool): bool {
  for x in xs {
    if test(x) { return true; }
  }
  return false;
}

pub fn all<T>(xs: T[], test: fn(T): bool): bool {
  for x in xs {
    if !test(x) { return false; }
  }
  return true;
}

pub fn range(lo: int, hi: int): int[] {
  let out: int[] = [];
  for i in lo..hi { push(out, i); }
  return out;
}

pub fn sum(xs: int[]): int {
  var total = 0;
  for x in xs { total += x; }
  return total;
}

pub fn count<T>(xs: T[], test: fn(T): bool): int {
  var n = 0;
  for x in xs {
    if test(x) { n += 1; }
  }
  return n;
}

// -1 when nothing matches
pub fn find_index<T>(xs: T[], test: fn(T): bool): int {
  for i in 0..len(xs) {
    if test(xs[i]) { return i; }
  }
  return -1;
}

pub fn take<T>(xs: T[], n: int): T[] {
  let out: T[] = [];
  for i in 0..len(xs) {
    if i >= n { break; }
    push(out, xs[i]);
  }
  return out;
}

pub fn drop<T>(xs: T[], n: int): T[] {
  let out: T[] = [];
  for i in n..len(xs) { push(out, xs[i]); }
  return out;
}

// stops at the shorter array
pub fn zip_with<A, B, C>(xs: A[], ys: B[], f: fn(A, B): C): C[] {
  let out: C[] = [];
  let n = if len(xs) < len(ys) { len(xs) } else { len(ys) };
  for i in 0..n { push(out, f(xs[i], ys[i])); }
  return out;
}

// stable merge sort, `before(a, b)` true when a must come first
pub fn sort_by<T>(xs: T[], before: fn(T, T): bool): T[] {
  var cur: T[] = [];
  for x in xs { push(cur, x); }
  let n = len(cur);
  var width = 1;
  while width < n {
    let next: T[] = [];
    var lo = 0;
    while lo < n {
      let mid = if lo + width < n { lo + width } else { n };
      let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
      var i = lo;
      var j = mid;
      while i < mid && j < hi {
        if before(cur[j], cur[i]) {
          push(next, cur[j]);
          j += 1;
        } else {
          push(next, cur[i]);
          i += 1;
        }
      }
      while i < mid { push(next, cur[i]); i += 1; }
      while j < hi { push(next, cur[j]); j += 1; }
      lo += 2 * width;
    }
    cur = next;
    width *= 2;
  }
  return cur;
}
