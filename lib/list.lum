// higher-order helpers over arrays. none of them change their input
import "std/map.lum"

pub fn map<T, U>(xs: T[], f: fn(T): U): U[] {
  let out: U[] = [];
  for x in xs { push(out, f(x)); }
  return out;
}

pub fn filter<T>(xs: T[], keep: fn(T): bool): T[] {
  let out: T[] = [];
  for x in xs {
    if keep(x) { push(out, x); }
  }
  return out;
}

pub fn fold<T, A>(xs: T[], start: A, step: fn(A, T): A): A {
  var acc = start;
  for x in xs { acc = step(acc, x); }
  return acc;
}

pub fn any<T>(xs: T[], test: fn(T): bool): bool {
  for x in xs {
    if test(x) { return true; }
  }
  return false;
}

pub fn all<T>(xs: T[], test: fn(T): bool): bool {
  for x in xs {
    if !test(x) { return false; }
  }
  return true;
}

pub fn range(lo: int, hi: int): int[] {
  let out: int[] = [];
  for i in lo..hi { push(out, i); }
  return out;
}

pub fn sum(xs: int[]): int {
  var total = 0;
  for x in xs { total += x; }
  return total;
}

pub fn count<T>(xs: T[], test: fn(T): bool): int {
  var n = 0;
  for x in xs {
    if test(x) { n += 1; }
  }
  return n;
}

// -1 when nothing matches
pub fn find_index<T>(xs: T[], test: fn(T): bool): int {
  for i in 0..len(xs) {
    if test(xs[i]) { return i; }
  }
  return -1;
}

pub fn take<T>(xs: T[], n: int): T[] {
  let out: T[] = [];
  for i in 0..len(xs) {
    if i >= n { break; }
    push(out, xs[i]);
  }
  return out;
}

pub fn drop<T>(xs: T[], n: int): T[] {
  let out: T[] = [];
  for i in n..len(xs) { push(out, xs[i]); }
  return out;
}

// stops at the shorter array
pub fn zip_with<A, B, C>(xs: A[], ys: B[], f: fn(A, B): C): C[] {
  let out: C[] = [];
  let n = if len(xs) < len(ys) { len(xs) } else { len(ys) };
  for i in 0..n { push(out, f(xs[i], ys[i])); }
  return out;
}

// stable merge sort, `before(a, b)` true when a must come first
pub fn sort_by<T>(xs: T[], before: fn(T, T): bool): T[] {
  var cur: T[] = [];
  for x in xs { push(cur, x); }
  let n = len(cur);
  var width = 1;
  while width < n {
    let next: T[] = [];
    var lo = 0;
    while lo < n {
      let mid = if lo + width < n { lo + width } else { n };
      let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
      var i = lo;
      var j = mid;
      while i < mid && j < hi {
        if before(cur[j], cur[i]) {
          push(next, cur[j]);
          j += 1;
        } else {
          push(next, cur[i]);
          i += 1;
        }
      }
      while i < mid { push(next, cur[i]); i += 1; }
      while j < hi { push(next, cur[j]); j += 1; }
      lo += 2 * width;
    }
    cur = next;
    width *= 2;
  }
  return cur;
}

pub fn flatten<T>(xss: T[][]): T[] {
  let out: T[] = [];
  for xs in xss {
    for x in xs { push(out, x); }
  }
  return out;
}

pub fn flat_map<T, U>(xs: T[], f: fn(T): U[]): U[] {
  let out: U[] = [];
  for x in xs {
    for y in f(x) { push(out, y); }
  }
  return out;
}

// first occurrence wins, order is kept
pub fn unique<T>(xs: T[]): T[] {
  let out: T[] = [];
  for x in xs {
    if !contains(out, x) { push(out, x); }
  }
  return out;
}

pub fn max_of(xs: int[]): int {
  var best = xs[0];
  for x in xs {
    if x > best { best = x; }
  }
  return best;
}

pub fn min_of(xs: int[]): int {
  var best = xs[0];
  for x in xs {
    if x < best { best = x; }
  }
  return best;
}

pub fn equal<T>(xs: T[], ys: T[]): bool {
  if len(xs) != len(ys) { return false; }
  for i in 0..len(xs) {
    if xs[i] != ys[i] { return false; }
  }
  return true;
}

// -1 when x is not there
pub fn index_of<T>(xs: T[], x: T): int {
  for i in 0..len(xs) {
    if xs[i] == x { return i; }
  }
  return -1;
}

pub fn reversed<T>(xs: T[]): T[] {
  let out = slice(xs, 0, len(xs));
  reverse(out);
  return out;
}

pub fn zip<A, B>(xs: A[], ys: B[]): (A, B)[] {
  let out: (A, B)[] = [];
  let n = if len(xs) < len(ys) { len(xs) } else { len(ys) };
  for i in 0..n { push(out, (xs[i], ys[i])); }
  return out;
}

pub fn enumerate<T>(xs: T[]): (int, T)[] {
  let out: (int, T)[] = [];
  for i, x in xs { push(out, (i, x)); }
  return out;
}

// (items that pass, items that do not)
pub fn partition<T>(xs: T[], test: fn(T): bool): (T[], T[]) {
  let yes: T[] = [];
  let no: T[] = [];
  for x in xs {
    if test(x) { push(yes, x); } else { push(no, x); }
  }
  return (yes, no);
}

pub fn take_while<T>(xs: T[], keep: fn(T): bool): T[] {
  let out: T[] = [];
  for x in xs {
    if !keep(x) { break; }
    push(out, x);
  }
  return out;
}

pub fn drop_while<T>(xs: T[], skip: fn(T): bool): T[] {
  let out: T[] = [];
  var dropping = true;
  for x in xs {
    if dropping && skip(x) { continue; }
    dropping = false;
    push(out, x);
  }
  return out;
}

pub fn chunks<T>(xs: T[], size: int): T[][] {
  let out: T[][] = [];
  var cur: T[] = [];
  for x in xs {
    push(cur, x);
    if len(cur) == size {
      push(out, cur);
      cur = [];
    }
  }
  if len(cur) > 0 { push(out, cur); }
  return out;
}

pub fn max_by<T>(xs: T[], key: fn(T): int): T {
  var best = xs[0];
  for x in xs {
    if key(x) > key(best) { best = x; }
  }
  return best;
}

pub fn min_by<T>(xs: T[], key: fn(T): int): T {
  var best = xs[0];
  for x in xs {
    if key(x) < key(best) { best = x; }
  }
  return best;
}

pub fn last<T>(xs: T[]): T {
  return xs[len(xs) - 1];
}

pub fn sum_by<T>(xs: T[], key: fn(T): int): int {
  var total = 0;
  for x in xs { total += key(x); }
  return total;
}

// every run of `size` neighbours, so [1, 2, 3] with 2 gives [1, 2] and [2, 3]
pub fn windows<T>(xs: T[], size: int): T[][] {
  let out: T[][] = [];
  var at = 0;
  while at + size <= len(xs) {
    push(out, xs[at..at + size]);
    at += 1;
  }
  return out;
}

// the elements whose key is the same, in first-seen order of the keys
pub fn group_by<T>(xs: T[], key: fn(T): string): map.Map<T[]> {
  let out: map.Map<T[]> = map.new();
  for x in xs {
    let k = key(x);
    if !map.has(out, k) {
      let fresh: T[] = [];
      map.set(out, k, fresh);
    }
    push(map.get(out, k, []), x);
  }
  return out;
}

pub fn product(xs: int[]): int {
  var total = 1;
  for x in xs { total *= x; }
  return total;
}

// moves the first k elements to the back; k may be negative or larger than the array
pub fn rotate<T>(xs: T[], k: int): T[] {
  let n = len(xs);
  if n == 0 { return []; }
  let s = ((k % n) + n) % n;
  return flatten([xs[s..], xs[..s]]);
}

pub fn count_by<T>(xs: T[], key: fn(T): string): map.Map<int> {
  let out: map.Map<int> = map.new();
  for x in xs { map.update(out, key(x), 0, fn(c: int): int => c + 1); }
  return out;
}
