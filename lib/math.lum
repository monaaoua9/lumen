// small integer helpers
pub fn gcd(a: int, b: int): int {
  var x = abs(a);
  var y = abs(b);
  while y != 0 {
    let t = x % y;
    x = y;
    y = t;
  }
  return x;
}

pub fn lcm(a: int, b: int): int {
  if a == 0 || b == 0 { return 0; }
  return abs(a / gcd(a, b) * b);
}

pub fn pow(base: int, exp: int): int {
  var out = 1;
  for _ in 0..exp { out *= base; }
  return out;
}

pub fn clamp(v: int, lo: int, hi: int): int {
  return max(lo, min(v, hi));
}

pub fn is_prime(n: int): bool {
  if n < 2 { return false; }
  var d = 2;
  while d * d <= n {
    if n % d == 0 { return false; }
    d += 1;
  }
  return true;
}

pub fn sign(n: int): int {
  return if n > 0 { 1 } else if n < 0 { -1 } else { 0 };
}

pub fn factorial(n: int): int {
  var out = 1;
  for i in 2..n + 1 { out *= i; }
  return out;
}

// floor of the square root, exact for every int (no float rounding)
pub fn isqrt(n: int): int {
  var lo = 0;
  var hi = n + 1;
  while hi - lo > 1 {
    let mid = (lo + hi) / 2;
    if mid <= n / mid { lo = mid; } else { hi = mid; }
  }
  return lo;
}

pub fn digit_sum(n: int): int {
  var rest = abs(n);
  var total = 0;
  while rest > 0 {
    total += rest % 10;
    rest /= 10;
  }
  return total;
}

// base^exp mod m without overflowing for m below ~9e7
pub fn mod_pow(base: int, exp: int, m: int): int {
  var result = 1 % m;
  var b = base % m;
  var e = exp;
  while e > 0 {
    if e % 2 == 1 { result = result * b % m; }
    b = b * b % m;
    e = e / 2;
  }
  return result;
}

pub fn fib(n: int): int {
  var a = 0;
  var b = 1;
  for _i in 0..n { a, b = b, a + b; }
  return a;
}

pub fn lerp(a: float, b: float, t: float): float {
  return a + (b - a) * t;
}

pub fn hypot(x: float, y: float): float {
  return sqrt(x * x + y * y);
}

// float base, whole exponent; negative exponents divide
pub fn fpow(base: float, exp: int): float {
  var r = 1.0;
  for _i in 0..abs(exp) { r *= base; }
  return if exp < 0 { 1.0 / r } else { r };
}
