import "std/map.lum"

// set of strings, kept in insertion order. membership goes through a std/map, so it is a hash lookup
pub struct Set { items: string[], seen: map.Map<bool> }

pub fn new(): Set {
  let seen: map.Map<bool> = map.new();
  return Set { items: [], seen: seen };
}

pub fn from(xs: string[]): Set {
  let s = new();
  for x in xs { add(s, x); }
  return s;
}

pub fn has(s: Set, x: string): bool {
  return map.has(s.seen, x);
}

// true when x was not there before
pub fn add(s: Set, x: string): bool {
  if has(s, x) { return false; }
  push(s.items, x);
  map.set(s.seen, x, true);
  return true;
}

pub fn drop(s: Set, x: string): bool {
  if !has(s, x) { return false; }
  for i in 0..len(s.items) {
    if s.items[i] == x {
      remove(s.items, i);
      break;
    }
  }
  map.delete(s.seen, x);
  return true;
}

pub fn size(s: Set): int {
  return len(s.items);
}

pub fn items(s: Set): string[] {
  return slice(s.items, 0, len(s.items));
}

pub fn union(a: Set, b: Set): Set {
  let out = from(a.items);
  for x in b.items { add(out, x); }
  return out;
}

pub fn intersect(a: Set, b: Set): Set {
  let out = new();
  for x in a.items {
    if has(b, x) { add(out, x); }
  }
  return out;
}

pub fn minus(a: Set, b: Set): Set {
  let out = new();
  for x in a.items {
    if !has(b, x) { add(out, x); }
  }
  return out;
}

pub fn is_subset(a: Set, b: Set): bool {
  for x in a.items {
    if !has(b, x) { return false; }
  }
  return true;
}

pub fn equal(a: Set, b: Set): bool {
  return size(a) == size(b) && is_subset(a, b);
}
