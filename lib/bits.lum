// bit operations for non-negative ints, done with arithmetic since the language has no bitwise operators
fn combine(a: int, b: int, mode: int): int {
  var out = 0;
  var bit = 1;
  var x = a;
  var y = b;
  while x > 0 || y > 0 {
    let p = x % 2;
    let q = y % 2;
    let on = if mode == 0 { p == 1 && q == 1 } else if mode == 1 { p == 1 || q == 1 } else { p != q };
    if on { out += bit; }
    bit *= 2;
    x /= 2;
    y /= 2;
  }
  return out;
}

pub fn band(a: int, b: int): int { return combine(a, b, 0); }
pub fn bor(a: int, b: int): int { return combine(a, b, 1); }
pub fn bxor(a: int, b: int): int { return combine(a, b, 2); }

pub fn shl(x: int, n: int): int {
  var out = x;
  for _i in 0..n { out *= 2; }
  return out;
}

pub fn shr(x: int, n: int): int {
  var out = x;
  for _i in 0..n { out /= 2; }
  return out;
}

pub fn popcount(x: int): int {
  var n = 0;
  var v = x;
  while v > 0 {
    n += v % 2;
    v /= 2;
  }
  return n;
}
