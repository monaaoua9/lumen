// the operators do the real work now; these stay for code written before they existed
pub fn band(a: int, b: int): int { return a & b; }
pub fn bor(a: int, b: int): int { return a | b; }
pub fn bxor(a: int, b: int): int { return a ^ b; }
pub fn shl(x: int, n: int): int { return x << n; }
pub fn shr(x: int, n: int): int { return x >> n; }

pub fn popcount(x: int): int {
  var n = 0;
  var v = x;
  while v > 0 {
    n += v & 1;
    v = v >> 1;
  }
  return n;
}

pub fn bit_set(x: int, i: int): bool { return (x >> i) & 1 == 1; }
