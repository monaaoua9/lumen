// small backtracking matcher. supports . [abc] [a-z] [^x] \d \w \s \. and * + ? {n} {n,m} after an atom or a group,
// groups (...) and (?:...) with | inside them, ^ and $, | between alternatives. works on bytes,
// except that . and negated classes step over a whole UTF-8 character. no lazy quantifiers, no backreferences

fn char_len(text: string, i: int): int {
  if i >= len(text) { return -1; }
  var n = 1;
  while i + n < len(text) && byte(text, i + n) >= 128 && byte(text, i + n) < 192 { n += 1; }
  return n;
}

fn is_word(c: int): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

// index just past the atom that starts at pi
fn atom_end(pat: string, pi: int): int {
  let c = byte(pat, pi);
  if c == 92 { return min(pi + 2, len(pat)); }
  if c == 91 {
    var j = pi + 1;
    if j < len(pat) && byte(pat, j) == 94 { j += 1; }
    // a ] right after [ or [^ is a plain member
    if j < len(pat) { j += 1; }
    while j < len(pat) && byte(pat, j) != 93 { j += 1; }
    return min(j + 1, len(pat));
  }
  return pi + max(char_len(pat, pi), 1);
}

fn class_has(pat: string, pi: int, pe: int, c: int): bool {
  var j = pi + 1;
  var neg = false;
  if byte(pat, j) == 94 { neg = true; j += 1; }
  var hit = false;
  let end = pe - 1;
  while j < end {
    var lo = byte(pat, j);
    if lo == 92 && j + 1 < end {
      j += 1;
      lo = byte(pat, j);
      if lo == 100 { if c >= 48 && c <= 57 { hit = true; } j += 1; continue; }
      if lo == 119 { if is_word(c) { hit = true; } j += 1; continue; }
      if lo == 115 { if c == 32 || (c >= 9 && c <= 13) { hit = true; } j += 1; continue; }
    }
    if j + 2 < end && byte(pat, j + 1) == 45 {
      if c >= lo && c <= byte(pat, j + 2) { hit = true; }
      j += 3;
    } else {
      if c == lo { hit = true; }
      j += 1;
    }
  }
  return hit != neg;
}

// how many bytes the atom eats at text[ti], -1 when it does not match
fn atom_len(pat: string, pi: int, pe: int, text: string, ti: int): int {
  if ti >= len(text) { return -1; }
  let c = byte(pat, pi);
  let t = byte(text, ti);
  if c == 46 { return char_len(text, ti); }
  if c == 91 {
    if class_has(pat, pi, pe, t) { return char_len(text, ti); }
    return -1;
  }
  if c == 92 && pi + 1 < len(pat) {
    let e = byte(pat, pi + 1);
    if e == 100 { if t >= 48 && t <= 57 { return 1; } return -1; }
    if e == 119 { if is_word(t) { return 1; } return -1; }
    if e == 115 { if t == 32 || (t >= 9 && t <= 13) { return 1; } return -1; }
    if t == e { return 1; }
    return -1;
  }
  let n = pe - pi;
  if ti + n > len(text) { return -1; }
  // bytes, so a cut in the middle of a character in the text is just a mismatch
  var k = 0;
  while k < n {
    if byte(text, ti + k) != byte(pat, pi + k) { return -1; }
    k += 1;
  }
  return n;
}

// (least, most, index after the quantifier) for * + ? {n} {n,m} {n,}, or (0, 0, ae) when there is none
fn quantifier(pat: string, ae: int): (int, int, int) {
  if ae >= len(pat) { return (0, 0, ae); }
  let c = byte(pat, ae);
  let big = 1000000000;
  if c == 42 { return (0, big, ae + 1); }
  if c == 43 { return (1, big, ae + 1); }
  if c == 63 { return (0, 1, ae + 1); }
  if c != 123 { return (0, 0, ae); }
  var j = ae + 1;
  var lo = 0;
  var seen = false;
  while j < len(pat) && byte(pat, j) >= 48 && byte(pat, j) <= 57 {
    lo = lo * 10 + byte(pat, j) - 48;
    seen = true;
    j += 1;
  }
  if !seen || j >= len(pat) { return (0, 0, ae); }
  if byte(pat, j) == 125 { return (lo, lo, j + 1); }
  if byte(pat, j) != 44 { return (0, 0, ae); }
  j += 1;
  var hi = big;
  if j < len(pat) && byte(pat, j) >= 48 && byte(pat, j) <= 57 {
    hi = 0;
    while j < len(pat) && byte(pat, j) >= 48 && byte(pat, j) <= 57 {
      hi = hi * 10 + byte(pat, j) - 48;
      j += 1;
    }
  }
  if j >= len(pat) || byte(pat, j) != 125 { return (0, 0, ae); }
  return (lo, hi, j + 1);
}

// index of the ) that closes the ( at pi, or len(pat) when it is never closed
fn group_end(pat: string, pi: int): int {
  var depth = 0;
  var i = pi;
  var in_class = false;
  while i < len(pat) {
    let c = byte(pat, i);
    if c == 92 { i += 2; continue; }
    if in_class {
      if c == 93 { in_class = false; }
    } else if c == 91 {
      in_class = true;
    } else if c == 40 {
      depth += 1;
    } else if c == 41 {
      depth -= 1;
      if depth == 0 { return i; }
    }
    i += 1;
  }
  return len(pat);
}

// flat (start, end, start, end ...) of the | separated alternatives of pat[lo..hi], ignoring | inside () and []
fn alt_bounds(pat: string, lo: int, hi: int): int[] {
  let out: int[] = [];
  var start = lo;
  var depth = 0;
  var i = lo;
  var in_class = false;
  while i < hi {
    let c = byte(pat, i);
    if c == 92 { i += 2; continue; }
    if in_class {
      if c == 93 { in_class = false; }
    } else if c == 91 {
      in_class = true;
    } else if c == 40 {
      depth += 1;
    } else if c == 41 {
      depth -= 1;
    } else if c == 124 && depth == 0 {
      push(out, start);
      push(out, i);
      start = i + 1;
    }
    i += 1;
  }
  push(out, start);
  push(out, hi);
  return out;
}

// how many capturing groups the pattern has
fn group_count(pat: string): int {
  var n = 0;
  var i = 0;
  var in_class = false;
  while i < len(pat) {
    let c = byte(pat, i);
    if c == 92 { i += 2; continue; }
    if in_class {
      if c == 93 { in_class = false; }
    } else if c == 91 {
      in_class = true;
    } else if c == 40 && !(i + 2 < len(pat) && byte(pat, i + 1) == 63 && byte(pat, i + 2) == 58) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

// number of the capturing group opened at pi (1 based), 0 for (?:...)
fn group_no(pat: string, pi: int): int {
  if pi + 2 < len(pat) && byte(pat, pi + 1) == 63 && byte(pat, pi + 2) == 58 { return 0; }
  return group_count(substr(pat, 0, pi)) + 1;
}

// tries every alternative of pat[lo..hi] at ti, then the continuation; the end of the whole match or -1
fn alts(pat: string, lo: int, hi: int, text: string, ti: int, caps: int[], kont: fn(int): int): int {
  let b = alt_bounds(pat, lo, hi);
  var i = 0;
  while i < len(b) {
    let r = m(pat, b[i], b[i + 1], text, ti, caps, kont);
    if r >= 0 { return r; }
    i += 2;
  }
  return -1;
}

// one more round of a repeated group (greedy), or the rest of the pattern once enough rounds are done
fn rep(pat: string, g: int, lo: int, hi: int, mn: int, mx: int, count: int, ti: int, qend: int, pe: int, text: string, caps: int[], kont: fn(int): int): int {
  if count < mx {
    let round = fn(e: int): int {
      // an empty round past the minimum would loop forever
      if e == ti && count >= mn { return -1; }
      var os = 0;
      var oe = 0;
      if g > 0 {
        os = caps[2 * g];
        oe = caps[2 * g + 1];
        caps[2 * g] = ti;
        caps[2 * g + 1] = e;
      }
      let r = rep(pat, g, lo, hi, mn, mx, count + 1, e, qend, pe, text, caps, kont);
      if r < 0 && g > 0 {
        caps[2 * g] = os;
        caps[2 * g + 1] = oe;
      }
      return r;
    };
    let r = alts(pat, lo, hi, text, ti, caps, round);
    if r >= 0 { return r; }
  }
  if count >= mn { return m(pat, qend, pe, text, ti, caps, kont); }
  return -1;
}

// match pat[pi..pe) at ti and then hand the position to kont; the end of the whole match or -1
fn m(pat: string, pi: int, pe: int, text: string, ti: int, caps: int[], kont: fn(int): int): int {
  if pi >= pe { return kont(ti); }
  let c = byte(pat, pi);
  if c == 94 {
    if ti != 0 { return -1; }
    return m(pat, pi + 1, pe, text, ti, caps, kont);
  }
  if c == 36 {
    if ti != len(text) { return -1; }
    return m(pat, pi + 1, pe, text, ti, caps, kont);
  }
  if c == 40 {
    let close = min(group_end(pat, pi), pe);
    let g = group_no(pat, pi);
    var inner = pi + 1;
    if g == 0 { inner = pi + 3; }
    let qu = quantifier(pat, close + 1);
    var mn = 1;
    var mx = 1;
    var qend = close + 1;
    if qu.2 > close + 1 {
      mn = qu.0;
      mx = qu.1;
      qend = qu.2;
    }
    return rep(pat, g, inner, close, mn, mx, 0, ti, qend, pe, text, caps, kont);
  }
  let ae = atom_end(pat, pi);
  let qu = quantifier(pat, ae);
  if qu.2 > ae {
    let ends: int[] = [ti];
    var cur = ti;
    while len(ends) - 1 < qu.1 {
      let l = atom_len(pat, pi, ae, text, cur);
      if l < 0 { break; }
      cur += l;
      push(ends, cur);
    }
    var k = len(ends) - 1;
    while k >= qu.0 {
      let r = m(pat, qu.2, pe, text, ends[k], caps, kont);
      if r >= 0 { return r; }
      k -= 1;
    }
    return -1;
  }
  let l = atom_len(pat, pi, ae, text, ti);
  if l < 0 { return -1; }
  return m(pat, ae, pe, text, ti + l, caps, kont);
}

// end of the match of the whole pattern at ti (the whole text when `whole`), or -1
fn run(pat: string, text: string, ti: int, caps: int[], whole: bool): int {
  let done = fn(e: int): int {
    if whole && e != len(text) { return -1; }
    return e;
  };
  return alts(pat, 0, len(pat), text, ti, caps, done);
}

fn fresh(pat: string): int[] {
  let caps: int[] = [];
  for _i in 0..2 * (group_count(pat) + 1) { push(caps, -1); }
  return caps;
}

// (start, end) of the first match at or after `from`, (-1, -1) when there is none; caps gets the groups
fn find_caps(pat: string, text: string, from: int, caps: int[]): (int, int) {
  var s = from;
  while s <= len(text) {
    for i in 0..len(caps) { caps[i] = -1; }
    let e = run(pat, text, s, caps, false);
    if e >= 0 { return (s, e); }
    let step = char_len(text, s);
    if step < 0 { break; }
    s += step;
  }
  return (-1, -1);
}

pub fn search_from(pat: string, text: string, from: int): (int, int) {
  return find_caps(pat, text, from, fresh(pat));
}

pub fn search(pat: string, text: string): (int, int) {
  return search_from(pat, text, 0);
}

pub fn is_match(pat: string, text: string): bool {
  let r = search_from(pat, text, 0);
  return r.0 >= 0;
}

// the whole text has to match
pub fn full_match(pat: string, text: string): bool {
  return run(pat, text, 0, fresh(pat), true) >= 0;
}

// the first match followed by what each group matched (an empty string for a group that did not take part); empty when nothing matches
pub fn captures(pat: string, text: string): string[] {
  let caps = fresh(pat);
  let r = find_caps(pat, text, 0, caps);
  let out: string[] = [];
  if r.0 < 0 { return out; }
  push(out, substr(text, r.0, r.1 - r.0));
  for g in 1..len(caps) / 2 {
    if caps[2 * g] < 0 {
      push(out, "");
    } else {
      push(out, substr(text, caps[2 * g], caps[2 * g + 1] - caps[2 * g]));
    }
  }
  return out;
}

pub fn all_matches(pat: string, text: string): string[] {
  let out: string[] = [];
  var at = 0;
  while at <= len(text) {
    let r = search_from(pat, text, at);
    if r.0 < 0 { break; }
    push(out, substr(text, r.0, r.1 - r.0));
    if r.1 > r.0 { at = r.1; } else { at = r.1 + max(char_len(text, r.1), 1); }
  }
  return out;
}

// replaces every match; an empty match is skipped over one character
pub fn sub(pat: string, text: string, with: string): string {
  var out = "";
  var at = 0;
  while at <= len(text) {
    let r = search_from(pat, text, at);
    if r.0 < 0 { break; }
    out += substr(text, at, r.0 - at) + with;
    if r.1 > r.0 {
      at = r.1;
    } else {
      let n = char_len(text, r.1);
      if n < 0 { at = len(text) + 1; break; }
      out += substr(text, r.1, n);
      at = r.1 + n;
    }
  }
  if at <= len(text) { out += substr(text, at, len(text) - at); }
  return out;
}

// the pieces between matches; an empty match never splits
pub fn pieces(pat: string, text: string): string[] {
  let out: string[] = [];
  var from = 0;
  var at = 0;
  while at <= len(text) {
    let r = search_from(pat, text, at);
    if r.0 < 0 { break; }
    if r.1 == r.0 {
      let n = char_len(text, r.1);
      if n < 0 { break; }
      at = r.1 + n;
      continue;
    }
    push(out, substr(text, from, r.0 - from));
    from = r.1;
    at = r.1;
  }
  push(out, substr(text, from, len(text) - from));
  return out;
}
