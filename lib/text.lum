// text helpers. chars, reversed, char_count and pad_* walk UTF-8 characters, the rest is ASCII like the string builtins
// characters, not bytes: "مرحبا" is 5
pub fn char_count(s: string): int {
  var n = 0;
  for _c in s { n += 1; }
  return n;
}

pub fn pad_left(s: string, width: int, fill: string = " "): string {
  return repeat(fill, max(0, width - char_count(s))) + s;
}

pub fn pad_right(s: string, width: int, fill: string = " "): string {
  return s + repeat(fill, max(0, width - char_count(s)));
}

pub fn is_digits(s: string): bool {
  if len(s) == 0 { return false; }
  for i in 0..len(s) {
    let c = byte(s, i);
    if c < 48 || c > 57 { return false; }
  }
  return true;
}

pub fn is_alpha(s: string): bool {
  if len(s) == 0 { return false; }
  for i in 0..len(s) {
    let c = byte(s, i);
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return false; }
  }
  return true;
}

// whole characters, so UTF-8 text survives
pub fn reversed(s: string): string {
  var out = "";
  for ch in s { out = ch + out; }
  return out;
}

pub fn count(s: string, needle: string): int {
  if len(needle) == 0 { return 0; }
  var n = 0;
  var rest = s;
  var at = find(rest, needle);
  while at >= 0 {
    n += 1;
    rest = rest[at + len(needle)..];
    at = find(rest, needle);
  }
  return n;
}

pub fn words(s: string): string[] {
  let out: string[] = [];
  for w in split(s, " ") {
    if w != "" { push(out, w); }
  }
  return out;
}

pub fn lines(s: string): string[] {
  let out = split(s, "\n");
  // a trailing newline does not start another line
  if len(out) > 0 && out[len(out) - 1] == "" { pop(out); }
  return out;
}

pub fn capitalize(s: string): string {
  if len(s) == 0 { return s; }
  // the first character may be several bytes
  let first = s[0];
  return upper(first) + substr(s, len(first), len(s) - len(first));
}

pub fn center(s: string, width: int, fill: string): string {
  let gap = width - len(s);
  if gap <= 0 { return s; }
  let left = gap / 2;
  return repeat(fill, left) + s + repeat(fill, gap - left);
}

pub fn chars(s: string): string[] {
  let out: string[] = [];
  for ch in s { push(out, ch); }
  return out;
}

pub fn is_blank(s: string): bool {
  return len(trim(s)) == 0;
}

// x with exactly `digits` decimals, halves round away from zero. fine up to ~15 significant digits
pub fn fixed(x: float, digits: int): string {
  var scale = 1;
  for _i in 0..digits { scale *= 10; }
  let neg = x < 0.0;
  let v = if neg { 0.0 - x } else { x };
  let n = int(floor(v * float(scale) + 0.5));
  let whole = n / scale;
  var out = str(whole);
  if digits > 0 { out = out + "." + pad_left(str(n % scale), digits, "0"); }
  return if neg && n > 0 { "-" + out } else { out };
}

fn blank_at(s: string, i: int): bool {
  let c = byte(s, i);
  return c == 32 || c == 9 || c == 10 || c == 13;
}

pub fn trim_start(s: string): string {
  var i = 0;
  while i < len(s) && blank_at(s, i) { i += 1; }
  return s[i..len(s)];
}

pub fn trim_end(s: string): string {
  var j = len(s);
  while j > 0 && blank_at(s, j - 1) { j -= 1; }
  return s[0..j];
}

// text before and after the first `sep`; whole string and "" when it's missing
pub fn split_once(s: string, sep: string): (string, string) {
  let at = find(s, sep);
  if at < 0 { return (s, ""); }
  return (s[0..at], s[at + len(sep)..len(s)]);
}

// cuts to at most `width` bytes of whole characters and marks the cut with "..."
pub fn truncate(s: string, width: int): string {
  if char_count(s) <= width { return s; }
  var out = "";
  var n = 0;
  for ch in s {
    if n + 3 >= width { break; }
    out += ch;
    n += 1;
  }
  return out + "...";
}

pub fn title(s: string): string {
  let parts = split(s, " ");
  let out: string[] = [];
  for p in parts { push(out, capitalize(p)); }
  return join(out, " ");
}

// greedy word wrap, a word longer than the width gets a line of its own
pub fn wrap(s: string, width: int): string[] {
  let out: string[] = [];
  var line = "";
  for w in words(s) {
    if len(line) == 0 {
      line = w;
    } else if char_count(line) + 1 + char_count(w) <= width {
      line += " " + w;
    } else {
      push(out, line);
      line = w;
    }
  }
  if len(line) > 0 { push(out, line); }
  return out;
}

// `*` matches any run of characters, `?` exactly one
pub fn glob(pattern: string, s: string): bool {
  let p = chars(pattern);
  let t = chars(s);
  // ok[j] is whether the first i pattern characters match the first j text characters
  var ok: bool[] = [true];
  for _j in 0..len(t) { push(ok, false); }
  for i in 0..len(p) {
    let next: bool[] = [];
    push(next, ok[0] && p[i] == "*");
    for j in 1..len(t) + 1 {
      if p[i] == "*" {
        push(next, ok[j] || next[j - 1]);
      } else {
        push(next, ok[j - 1] && (p[i] == "?" || p[i] == t[j - 1]));
      }
    }
    ok = next;
  }
  return ok[len(t)];
}

// code point of the first character, the opposite of chr
pub fn ord(ch: string): int {
  let b = byte(ch, 0);
  if b < 128 { return b; }
  if b < 224 { return (b - 192) * 64 + byte(ch, 1) - 128; }
  if b < 240 { return (b - 224) * 4096 + (byte(ch, 1) - 128) * 64 + byte(ch, 2) - 128; }
  return (b - 240) * 262144 + (byte(ch, 1) - 128) * 4096 + (byte(ch, 2) - 128) * 64 + byte(ch, 3) - 128;
}
