// Option<T> and Result<T> (the error side is always a string)
pub enum Option<T> { Some(T), None }
pub enum Result<T> { Ok(T), Err(string) }

pub fn unwrap_or<T>(o: Option<T>, fallback: T): T {
  return match o {
    Some(v) => v,
    None => fallback,
  };
}

pub fn is_some<T>(o: Option<T>): bool {
  return match o {
    Some(_) => true,
    None => false,
  };
}

pub fn ok_or<T>(r: Result<T>, fallback: T): T {
  return match r {
    Ok(v) => v,
    Err(_) => fallback,
  };
}

pub fn is_ok<T>(r: Result<T>): bool {
  return match r {
    Ok(_) => true,
    Err(_) => false,
  };
}

pub fn map_option<T, U>(o: Option<T>, f: fn(T): U): Option<U> {
  return match o {
    Some(v) => Option.Some(f(v)),
    None => Option.None,
  };
}

pub fn map_result<T, U>(r: Result<T>, f: fn(T): U): Result<U> {
  return match r {
    Ok(v) => Result.Ok(f(v)),
    Err(m) => Result.Err(m),
  };
}

pub fn find_by<T>(xs: T[], test: fn(T): bool): Option<T> {
  for x in xs {
    if test(x) { return Option.Some(x); }
  }
  return Option.None;
}

pub fn first<T>(xs: T[]): Option<T> {
  return if len(xs) == 0 { Option.None } else { Option.Some(xs[0]) };
}

pub fn and_then<T, U>(o: Option<T>, f: fn(T): Option<U>): Option<U> {
  return match o {
    Some(v) => f(v),
    None => Option.None,
  };
}

pub fn unwrap_or_else<T>(o: Option<T>, make: fn(): T): T {
  return match o {
    Some(v) => v,
    None => make(),
  };
}

pub fn is_err<T>(r: Result<T>): bool {
  return !is_ok(r);
}

pub fn and_then_result<T, U>(r: Result<T>, f: fn(T): Result<U>): Result<U> {
  return match r {
    Ok(v) => f(v),
    Err(m) => Result.Err(m),
  };
}
