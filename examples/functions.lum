fn double(x: int): int { return x * 2; }
fn square(x: int): int { return x * x; }

fn apply(f: fn(int): int, x: int): int {
    return f(x);
}

fn map(xs: int[], f: fn(int): int): int[] {
    let out: int[] = [];
    for x in xs {
        push(out, f(x));
    }
    return out;
}

fn fold(xs: int[], init: int, f: fn(int, int): int): int {
    var acc = init;
    for x in xs {
        acc = f(acc, x);
    }
    return acc;
}

fn pick(name: string): fn(int): int {
    if name == "double" { return double; }
    return square;
}

let nums = [1, 2, 3, 4, 5];
print(apply(double, 21));
print(map(nums, square));
print(fold(nums, 0, fn(a: int, b: int): int { return a + b; }));
print(map(nums, fn(x: int): int { return x * 10 + 1; }));

let table = [double, square];
for f in table {
    print(f(7));
}

var op = pick("double");
print(op(5));
op = pick("other");
print(op(5));
