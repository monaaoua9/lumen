struct Pair { a: int, b: string }

fn first<T>(xs: T[]): T {
  return xs[0];
}

fn swap<A, B>(a: A, b: B): B {
  print(a);
  return b;
}

fn map<T, U>(xs: T[], f: fn(T): U): U[] {
  let out: U[] = [];
  for x in xs { push(out, f(x)); }
  return out;
}

fn fold<T, R>(xs: T[], init: R, f: fn(R, T): R): R {
  var acc = init;
  for x in xs { acc = f(acc, x); }
  return acc;
}

fn replicate<T>(x: T, n: int): T[] {
  let out: T[] = [];
  for _i in 0..n { push(out, x); }
  return out;
}

fn largest<T>(xs: T[], gt: fn(T, T): bool): T {
  var best = xs[0];
  for x in xs {
    if gt(x, best) { best = x; }
  }
  return best;
}

print(first([10, 20, 30]));
print(first(["a", "b"]));
print(first([Pair { a: 1, b: "x" }]));
print(swap(1, "two"));
print(map([1, 2, 3], fn(x: int): string { return str(x * 2) + "!"; }));
let k = 5;
print(map([1, 2, 3], fn(x: int): int { return x + k; }));
print(fold([1, 2, 3, 4], 0, fn(acc: int, x: int): int { return acc + x; }));
print(fold(["a", "b", "c"], "", fn(acc: string, x: string): string { return acc + x; }));
print(replicate("ab", 3));
print(replicate(1.5, 2));
print(largest([3, 9, 4], fn(a: int, b: int): bool { return a > b; }));
print(largest([2.5, 0.5], fn(a: float, b: float): bool { return a > b; }));
