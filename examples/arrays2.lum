// sort and reverse work in place, slice copies, contains is a linear search
let xs = [5, 3, 9, 1, 7];
sort(xs);
print(xs);
reverse(xs);
print(xs);
print(slice(xs, 1, 3));
print(contains(xs, 9));
print(contains(xs, 4));

let words = ["pear", "fig", "apple"];
sort(words);
print(words);
let fs = [2.5, -1.0, 0.5];
sort(fs);
print(fs);
let flags = [true, false];
print(contains(flags, false));
let grid = [[1, 2], [3, 4], [5, 6]];
print(slice(grid, 1, 2));

// insert shifts the tail right, remove hands back the element it took out
let q = [10, 20, 30];
insert(q, 1, 15);
insert(q, 4, 40);
print(q);
print(remove(q, 0));
remove(q, 2);
print(q);
let names = ["a", "b"];
insert(names, 0, "z");
print(remove(names, 1) + str(len(names)));
