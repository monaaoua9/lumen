fn popcount(n: int): int {
  var x = n;
  var c = 0;
  while x != 0 {
    c += x & 1;
    x = x >> 1;
  }
  return c;
}

fn is_pow2(n: int): bool { return n > 0 && (n & (n - 1)) == 0; }

fn hash(s: string): int {
  var h = 5381;
  for i in 0..len(s) {
    h = ((h << 5) + h + byte(s, i)) & 0xFFFFFF;
  }
  return h;
}

print(popcount(255), popcount(1 << 20), is_pow2(64), is_pow2(65));
print(6 & 3, 6 | 3, 6 ^ 3, ~5, -16 >> 2);
print(hash("lumen"), hash("لومن"));

let READ = 1;
let WRITE = 2;
let EXEC = 4;
var perm = READ | EXEC;
print(perm, (perm & WRITE) != 0, (perm & EXEC) != 0);
perm = perm ^ EXEC | WRITE;
print(perm);
var f = 0;
f |= 5;
f &= 6;
f ^= 3;
print(f);
