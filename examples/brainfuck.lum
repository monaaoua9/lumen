// a brainfuck interpreter, to see how the string builtins hold up on a real loop
fn run(prog: string, input: string): string {
  let tape: int[] = [];
  for _ in 0..64 { push(tape, 0); }
  var out = "";
  var ptr = 0;
  var pc = 0;
  var in_at = 0;
  let n = len(prog);

  while pc < n {
    let op = byte(prog, pc);
    if op == 62 { ptr += 1; }
    else if op == 60 { ptr -= 1; }
    else if op == 43 { tape[ptr] = (tape[ptr] + 1) % 256; }
    else if op == 45 { tape[ptr] = (tape[ptr] + 255) % 256; }
    else if op == 46 { out = out + chr(tape[ptr]); }
    else if op == 44 {
      if in_at < len(input) {
        tape[ptr] = byte(input, in_at);
        in_at += 1;
      } else { tape[ptr] = 0; }
    }
    else if op == 91 && tape[ptr] == 0 {
      var depth = 1;
      while depth > 0 {
        pc += 1;
        if byte(prog, pc) == 91 { depth += 1; }
        if byte(prog, pc) == 93 { depth -= 1; }
      }
    }
    else if op == 93 && tape[ptr] != 0 {
      var depth = 1;
      while depth > 0 {
        pc -= 1;
        if byte(prog, pc) == 93 { depth += 1; }
        if byte(prog, pc) == 91 { depth -= 1; }
      }
    }
    pc += 1;
  }
  return out;
}

print(run("++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.", ""));
print(run(",[.,]", "echo"));
