trait Shape {
    fn area(self): float;
    fn name(self): string;
}

struct Circle { r: float }
struct Rect { w: float, h: float }

impl Shape for Circle {
    fn area(self): float { return 3.0 * self.r * self.r; }
    fn name(self): string { return "circle"; }
}

impl Shape for Rect {
    fn area(self): float { return self.w * self.h; }
    fn name(self): string { return "rect"; }
}

fn describe<T: Shape>(s: T): string {
    return s.name() + " with area " + str(s.area());
}

fn total_area<T: Shape>(shapes: T[]): float {
    var sum = 0.0;
    for s in shapes { sum += s.area(); }
    return sum;
}

fn biggest<T: Shape>(shapes: T[]): T {
    var best = shapes[0];
    for s in shapes {
        if s.area() > best.area() { best = s; }
    }
    return best;
}

print(describe(Circle { r: 2.0 }));
print(describe(Rect { w: 2.0, h: 5.0 }));
print(total_area([Rect { w: 1.0, h: 2.0 }, Rect { w: 3.0, h: 4.0 }]));
print(biggest([Circle { r: 1.0 }, Circle { r: 3.0 }]));
