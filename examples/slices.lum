let nums = [10, 20, 30, 40, 50];
print(nums[1..3]);
print(nums[0..len(nums)]);
print(nums[2..2]);
let words = ["a", "b", "c"];
for i, w in words[1..3] {
  print(str(i) + w);
}
let word = "lumen";
print(word[1..4]);
print(word[0..0] + "|" + word[0..5]);
print(slice(word, 2, 2));
print(word[0] + word[4]);
var vowels = 0;
for i in 0..len(word) {
  if contains(["a", "e", "i", "o", "u"], word[i]) { vowels += 1; }
}
print(vowels);
var spaced = "";
for ch in "abc" { spaced += ch + "."; }
print(spaced);
for i, ch in word[0..2] { print(str(i) + ch); }
