fn pick(xs: int[], n: int): int {
  let v = {
    if n < 0 { return -1; }
    xs[n] * 2
  };
  return v + 1;
}
fn seek(xs: int[], t: int): string {
  for x in xs {
    let r = { if x == t { return "found {x}"; } x };
    print(r);
  }
  return "none";
}
print(pick([1, 2, 3], 1), pick([1, 2, 3], -5));
print(seek([4, 5, 6], 5), seek([1], 9));
let f = fn(n: int): int => { let q = { if n > 2 { return 100; } n }; q + 1 };
print(f(1), f(5));
