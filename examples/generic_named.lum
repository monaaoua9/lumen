fn pick<T>(a: T, b: T, first: bool = true): T { return if first { a } else { b }; }
fn main() {
  print(pick(1, 2, first: false));
  print(pick(b: 5, a: 6));
}
main();
print(pick("x", "y"));

struct Box<T> { v: T }
impl<T> Box<T> {
  fn put(self, _x: T, times: int = 1): int { return times * 10; }
}
let b = Box { v: 1 };
print(b.put(2, times: 3));
print(b.put(2));
