import "std/test.lum"
import "std/format.lum"
import "std/text.lum"

fn test_commas() {
  test.eq_str(format.commas(1234567), "1,234,567");
  test.eq_str(format.commas(-1000), "-1,000");
  test.eq_str(format.commas(0), "0");
}

fn test_percent() {
  test.eq_str(format.percent(1, 4), "25%");
  test.eq_str(format.percent(3, 0), "0%");
}

fn test_table() {
  test.eq_str(format.table([["a", "bb"], ["ccc", "d"]]), "a    bb\nccc  d\n");
}

fn test_wrap_and_glob() {
  test.eq_int(len(text.wrap("one two three four", 9)), 3);
  test.is_true(text.glob("a*c", "abbbc"), "star");
  test.is_true(!text.glob("a?c", "ac"), "question");
}

fn test_truncate() {
  test.eq_str(text.truncate("abcdefghij", 8), "abcde...");
  test.eq_str(text.truncate("abc", 8), "abc");
}
