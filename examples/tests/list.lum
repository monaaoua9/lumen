import "std/test.lum"
import "std/list.lum"

fn test_map_filter() {
  let sq = list.map([1, 2, 3, 4], fn(x) => x * x);
  test.eq_int(list.sum(sq), 30);
  test.eq_int(len(list.filter(sq, fn(x) => x > 4)), 2);
}

fn test_flat() {
  test.eq_int(len(list.flatten([[1, 2], [], [3]])), 3);
  test.eq_int(list.sum(list.flat_map([1, 2, 3], fn(x) => [x, x * 10])), 66);
}

fn test_unique() {
  test.eq_int(len(list.unique([3, 1, 3, 2, 1])), 3);
  test.eq_str(join(list.unique(["a", "b", "a"]), ","), "a,b");
}

fn test_extremes() {
  test.eq_int(list.max_of([4, 9, 2]), 9);
  test.eq_int(list.min_of([4, 9, 2]), 2);
}

fn test_sort_take() {
  let s = list.sort_by([5, 3, 8, 1], fn(a, b) => a < b);
  test.eq_int(s[0], 1);
  test.eq_int(list.sum(list.take(s, 2)), 4);
  test.eq_int(len(list.drop(s, 3)), 1);
}

fn test_equal_index() {
  test.is_true(list.equal([1, 2, 3], [1, 2, 3]), "same");
  test.is_true(!list.equal([1, 2], [2, 1]), "order matters");
  test.eq_int(list.index_of([5, 6, 7], 7), 2);
  test.eq_int(list.index_of([5, 6, 7], 1), -1);
  test.is_true(list.equal(list.reversed([1, 2, 3]), [3, 2, 1]), "reversed copy");
}

fn test_tuples() {
  let z = list.zip([1, 2, 3], ["a", "b"]);
  test.eq_int(len(z), 2);
  test.eq_str(z[1].1, "b");
  var total = 0;
  for (n, s) in z { total += n * len(s); }
  test.eq_int(total, 3);
  let (small, big) = list.partition([1, 5, 2, 8], fn(x) => x < 3);
  test.eq_int(len(small) * 10 + len(big), 22);
  var last = "";
  for i, (_, s) in list.enumerate(["p", "q"]) { last = last + str(i) + s; }
  test.eq_str(last, "0p1q");
}

fn test_slicing_helpers() {
  let xs = [1, 2, 3, 10, 4];
  test.eq_int(len(list.take_while(xs, fn(x) => x < 5)), 3);
  test.eq_int(len(list.drop_while(xs, fn(x) => x < 5)), 2);
  let cs = list.chunks(xs, 2);
  test.eq_int(len(cs), 3);
  test.eq_int(len(cs[2]), 1);
  test.eq_int(cs[1][1], 10);
}

fn test_by_helpers() {
  let ws = ["pear", "fig", "banana"];
  test.eq_str(list.max_by(ws, fn(w) => len(w)), "banana");
  test.eq_str(list.min_by(ws, fn(w) => len(w)), "fig");
  test.eq_str(list.last(ws), "banana");
  test.eq_int(list.sum_by(ws, fn(w) => len(w)), 13);
}
