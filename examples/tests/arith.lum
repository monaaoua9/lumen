import "std/math.lum"

fn test_gcd() {
  assert(math.gcd(12, 18) == 6, "gcd");
  assert(math.gcd(7, 13) == 1, "coprime");
}

fn test_pow() {
  assert(math.pow(2, 10) == 1024, "pow");
}

fn test_lcm() {
  assert(math.lcm(4, 6) == 12, "lcm");
}

fn test_isqrt() {
  assert(math.isqrt(1000000) == 1000, "perfect square");
  assert(math.isqrt(999999) == 999, "just below");
  assert(math.factorial(5) == 120, "factorial");
}
