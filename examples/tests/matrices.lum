import "std/test.lum"
import "std/matrix.lum"
import "std/encoding.lum"

fn test_mul() {
  let p = matrix.mul([[1, 2], [3, 4]], [[0, 1], [1, 0]]);
  test.eq_int(p[0][0], 2);
  test.eq_int(p[1][1], 3);
}

fn test_pow() {
  test.eq_int(matrix.pow([[1, 1], [1, 0]], 10)[0][1], 55);
}

fn test_transpose() {
  let t = matrix.transpose([[1, 2, 3]]);
  test.eq_int(len(t), 3);
  test.eq_int(t[2][0], 3);
}

fn test_hex() {
  test.eq_str(encoding.to_hex(255), "ff");
  test.eq_int(encoding.from_hex("FF"), 255);
  test.eq_int(encoding.from_hex("zz"), -1);
  test.eq_str(encoding.hex_encode("A"), "41");
}

fn test_base64() {
  test.eq_str(encoding.base64_encode("Man"), "TWFu");
  test.eq_str(encoding.base64_encode("Ma"), "TWE=");
}
