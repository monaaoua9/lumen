import "std/test.lum"
import "std/text.lum"

fn test_reversed() {
  test.eq_str(text.reversed("lumen"), "nemul");
}

fn test_capitalize() {
  test.eq_str(text.capitalize("arabic"), "Arabic");
  test.eq_int(len(text.words(" a  b ")), 2);
}

fn test_float() {
  test.eq_float(sqrt(2.0) * sqrt(2.0), 2.0, 0.0001);
}

fn test_fixed() {
  test.eq_str(text.fixed(3.14159, 2), "3.14");
  test.eq_str(text.fixed(-2.5, 1), "-2.5");
  test.eq_str(text.fixed(9.999, 2), "10.00");
  test.eq_str(text.fixed(12.0, 0), "12");
}

fn test_trim_split() {
  test.eq_str(text.trim_start("  a b "), "a b ");
  test.eq_str(text.trim_end("  a b \n"), "  a b");
  test.eq_str(text.trim_end("   "), "");
  let (k, v) = text.split_once("key=val=x", "=");
  test.eq_str(k, "key");
  test.eq_str(v, "val=x");
  let (all, rest) = text.split_once("none", "=");
  test.eq_str(all + rest, "none");
}

fn test_pad_default_fill() {
  test.eq_str(text.pad_left("7", 3), "  7");
  test.eq_str(text.pad_right("7", 3), "7  ");
  test.eq_str(text.pad_left("7", 3, "0"), "007");
}

fn test_utf8_walk() {
  let s = "مرحبا";
  test.eq_int(len(text.chars(s)), 5);
  test.eq_str(text.reversed(s), "ابحرم");
  test.eq_str(s[0], "م");
  test.eq_int(text.count("ببب", "ب"), 3);
  var n = 0;
  for _c in s { n += 1; }
  test.eq_int(n, 5);
}
