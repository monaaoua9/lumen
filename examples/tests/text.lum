import "std/test.lum"
import "std/text.lum"

fn test_reversed() {
  test.eq_str(text.reversed("lumen"), "nemul");
}

fn test_capitalize() {
  test.eq_str(text.capitalize("arabic"), "Arabic");
  test.eq_int(len(text.words(" a  b ")), 2);
}

fn test_float() {
  test.eq_float(sqrt(2.0) * sqrt(2.0), 2.0, 0.0001);
}

fn test_fixed() {
  test.eq_str(text.fixed(3.14159, 2), "3.14");
  test.eq_str(text.fixed(-2.5, 1), "-2.5");
  test.eq_str(text.fixed(9.999, 2), "10.00");
  test.eq_str(text.fixed(12.0, 0), "12");
}
