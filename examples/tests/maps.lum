import "std/test.lum"
import "std/map.lum"
import "std/option.lum"

fn test_map_basics() {
  let m: map.Map<int> = map.new();
  map.set(m, "a", 1);
  map.set(m, "b", 2);
  map.set(m, "a", 5);
  test.eq_int(map.size(m), 2);
  test.eq_int(map.get(m, "a", 0), 5);
  test.eq_int(map.get(m, "zz", -1), -1);
  test.is_true(map.delete(m, "b"), "delete existing");
  test.is_true(!map.has(m, "b"), "gone after delete");
}

fn test_map_update() {
  let m: map.Map<int> = map.new();
  for w in ["x", "y", "x"] {
    map.update(m, w, 0, fn(n) => n + 1);
  }
  test.eq_int(map.get(m, "x", 0), 2);
  test.eq_str(join(map.keys(m), "+"), "x+y");
}

fn test_option() {
  let o = option.Option.Some(4);
  test.eq_int(option.unwrap_or(option.map_option(o, fn(v) => v * 3), 0), 12);
  let none: option.Option<int> = option.Option.None;
  test.eq_int(option.unwrap_or(option.map_option(none, fn(v) => v * 3), -1), -1);
}

fn test_from_entries_merge() {
  let a = map.from_entries([("x", 1), ("y", 2)]);
  let b = map.from_entries([("y", 20), ("z", 30)]);
  let m = map.merge(a, b);
  test.eq_int(map.size(m), 3);
  test.eq_int(map.get(m, "y", 0), 20);
  test.eq_int(map.get(a, "y", 0), 2);
}

fn test_many_keys() {
  let m: map.Map<int> = map.new();
  for i in 0..3000 { map.set(m, "key{i}", i); }
  test.eq_int(map.size(m), 3000);
  test.eq_int(map.get(m, "key2999", -1), 2999);
  test.eq_int(map.get(m, "key1500", -1), 1500);
  test.eq_bool(map.has(m, "key3000"), false);
  test.eq_bool(map.delete(m, "key10"), true);
  test.eq_int(map.get(m, "key10", -1), -1);
  test.eq_int(map.get(m, "key11", -1), 11);
  test.eq_int(map.size(m), 2999);
  map.set(m, "key11", 0);
  test.eq_int(map.get(m, "key11", -1), 0);
}
