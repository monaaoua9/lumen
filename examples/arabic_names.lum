struct طالب { اسم: string, درجة: int }
let قائمة = [طالب { اسم: "علي", درجة: 80 }, طالب { اسم: "زينب", درجة: 95 }];
var مجموع = 0;
for ط in قائمة { مجموع += ط.درجة; }
print("المعدل: {مجموع / len(قائمة)}");
enum حالة { ناجح, راسب }
fn حكم(د: int): حالة { return if د >= 50 { حالة.ناجح } else { حالة.راسب }; }
for ط in قائمة {
  match حكم(ط.درجة) {
    ناجح => print("{ط.اسم}: ناجح"),
    راسب => print("{ط.اسم}: راسب"),
  }
}
