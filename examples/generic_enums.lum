enum Option<T> {
    Some(T),
    None,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

fn find<T>(xs: T[], pred: fn(T): bool): Option<T> {
    for x in xs {
        if pred(x) { return Option.Some(x); }
    }
    return Option.None;
}

fn unwrap_or<T>(o: Option<T>, fallback: T): T {
    match o {
        Some(v) => { return v; }
        None => { return fallback; }
    }
}

fn divide(a: int, b: int): Result<int, string> {
    if b == 0 { return Result.Err("divide by zero"); }
    return Result.Ok(a / b);
}

fn show(r: Result<int, string>) {
    match r {
        Ok(v) => { print("ok " + str(v)); }
        Err(m) => { print("error: " + m); }
    }
}

let nums = [3, 8, 12];
print(unwrap_or(find(nums, fn(x: int): bool { return x > 5; }), -1));
print(unwrap_or(find(nums, fn(x: int): bool { return x > 50; }), -1));
print(find(["a", "bb"], fn(s: string): bool { return len(s) > 1; }));
show(divide(10, 2));
show(divide(1, 0));
let none: Option<float> = Option.None;
print(none);
let some: Option<int> = Option.Some(7);
print(some);
