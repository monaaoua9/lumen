import "std/option.lum";
enum Tok { Num(int), Op(string), Pair(int, int) }
struct P { x: int, y: int }

fn classify(t: Tok): string {
  return match t {
    Num(0) => "zero",
    Num(n) if n < 0 => "neg",
    Num(_) => "pos",
    Op("+") | Op("-") => "additive",
    Op(o) => "op " + o,
    Pair(a, b) if a == b => "twin",
    Pair(_, _) => "pair",
  };
}
for t in [Tok.Num(0), Tok.Num(-3), Tok.Num(8), Tok.Op("-"), Tok.Op("*"), Tok.Pair(2, 2), Tok.Pair(1, 2)] { print(classify(t)); }
let p = P { x: 3, y: 4 };
let P { x, y } = p;
print(x + y);
let o: Option<int> = Option.Some(5);
match o {
  Some(5) => print("five"),
  Some(n) => print("some", n),
  None => print("none"),
}
match Tok.Pair(0, 7) {
  Pair(0, k) => print("starts at zero, second is", k),
  Pair(_, _) => print("other"),
  _ => print("not a pair"),
}
