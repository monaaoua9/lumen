fn make_counter(): fn(): int {
  var n = 0;
  return fn(): int {
    n = n + 1;
    return n;
  };
}

let a = make_counter();
let b = make_counter();
print(a());
print(a());
print(b());
print(a());

fn shared() {
  var total = 0;
  let add = fn(x: int) { total += x; };
  let get = fn(): int { return total; };
  add(5);
  add(7);
  print(get());
  total = 100;
  print(get());
  add(1);
  print(total);
}
shared();
