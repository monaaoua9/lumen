import "std/date.lum"

print(date.to_days(1970, 1, 1), date.to_days(2000, 3, 1), date.to_days(1969, 12, 31));
let (y, m, d) = date.add_days(2024, 2, 28, 2);
print(date.iso(y, m, d));
print(date.weekday(2024, 1, 1), date.weekday(2000, 2, 29), date.weekday(1970, 1, 1));
print(date.is_leap(1900), date.is_leap(2000), date.days_in_month(2023, 2));
let (a, b, c) = date.from_days(-1);
print(date.iso(a, b, c));
