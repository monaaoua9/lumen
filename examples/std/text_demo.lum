import "std/text.lum"

print("[" + text.pad_left("42", 6, "0") + "]");
print("[" + text.pad_right("ab", 5, ".") + "]");
print("[" + text.pad_left("toolong", 3, " ") + "]");
print(text.is_digits("12345") && !text.is_digits("12a") && !text.is_digits(""));
print(text.is_alpha("Lumen") && !text.is_alpha("Lumen1"));
print(text.reversed("stressed"));
print(text.count("banana", "an") + text.count("aaaa", "aa") * 10);
print(text.words("  the  quick   fox "));
print(text.lines("a\nbb\n\nccc\n"));
print(len(text.lines("")));
print(text.capitalize("lumen") + text.capitalize(""));
print("[" + text.center("hi", 7, "*") + "]");
for i, c in text.chars("abc") {
  print(str(i) + c);
}
print(text.is_blank("  \t ") && !text.is_blank(" x "));
print(len(text.chars("")));
print(text.fixed(3.14159, 2) + " " + text.fixed(2.5, 0) + " " + text.fixed(0.05, 1) + " " + text.fixed(-1.005, 2) + " " + text.fixed(7.0, 3) + " " + text.fixed(-0.001, 2));
