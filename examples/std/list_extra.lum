import "std/list.lum"
import "std/map.lum"

print(product([1, 2, 3, 4]), product([]));
print(rotate([1, 2, 3, 4, 5], 2), rotate([1, 2, 3], -1), rotate([1, 2, 3], 7));
let c = count_by(["apple", "avocado", "banana", "blueberry", "cherry"], fn(w: string): string => substr(w, 0, 1));
for k in map.keys(c) { print(k, map.get(c, k, 0)); }
