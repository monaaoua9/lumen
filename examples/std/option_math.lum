import "std/option.lum"
import "std/math.lum"

fn safe_div(a: int, b: int): option.Result<int> {
  if b == 0 { return option.Result.Err("divide by zero"); }
  return option.Result.Ok(a / b);
}

fn first_even(xs: int[]): option.Option<int> {
  for x in xs {
    if x % 2 == 0 { return option.Option.Some(x); }
  }
  return option.Option.None;
}

print(option.ok_or(safe_div(10, 2), -1));
print(option.ok_or(safe_div(1, 0), -1));
print(option.is_ok(safe_div(1, 0)));
print(option.unwrap_or(first_even([3, 5, 8, 9]), 0));
print(option.is_some(first_even([1, 3])));
print(math.gcd(84, 36));
print(math.lcm(4, 6));
print(math.pow(2, 10));
print(math.clamp(15, 0, 10));
print(math.is_prime(97));
