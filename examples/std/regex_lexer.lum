import "std/regex.lum";
import "std/option.lum";

enum Tok { Num(int), Ident(string), Sym(string) }

// reads one token at `at`, returns it with the index after it
fn next_tok(src: string, at: int): Option<(Tok, int)> {
  var i = at;
  while i < len(src) && byte(src, i) == 32 { i += 1; }
  if i >= len(src) { return Option.None; }
  let rest = src[i..];
  let n = regex.search("^\\d+", rest);
  if n.0 == 0 { return Option.Some((Tok.Num(parse_int(rest[..n.1], 0)), i + n.1)); }
  let w = regex.search("^[a-zA-Z_]\\w*", rest);
  if w.0 == 0 { return Option.Some((Tok.Ident(rest[..w.1]), i + w.1)); }
  return Option.Some((Tok.Sym(rest[..1]), i + 1));
}

fn lex(src: string): Tok[] {
  let out: Tok[] = [];
  var at = 0;
  while let Some((t, nx)) = next_tok(src, at) {
    push(out, t);
    at = nx;
  }
  return out;
}

for t in lex("let x1 = 42 + foo_bar*7;") {
  match t {
    Num(n) => print("num", n),
    Ident(s) => print("id", s),
    Sym(s) => print("sym", s),
  }
}
