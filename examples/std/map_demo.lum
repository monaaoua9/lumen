// the same job as wordfreq.lum with std/map.lum doing the bookkeeping
import "std/map.lum"

let counts: map.Map<int> = map.Map { keys: [], vals: [] };
for w in split("a rose is a rose is a rose", " ") {
  map.set(counts, w, map.get(counts, w, 0) + 1);
}
for k in counts.keys {
  print("{k} -> {map.get(counts, k, 0)}");
}
print(map.size(counts));
print(map.has(counts, "rose"));
print(map.delete(counts, "rose"));
print(map.delete(counts, "rose"));
print(map.size(counts));
