enum Result<T> { Ok(T), Err(string) }
enum Option<T> { Some(T), None }

fn half(n: int): Result<int> {
  if n % 2 != 0 { return Result.Err("odd {n}"); }
  return Result.Ok(n / 2);
}
fn first_even(xs: int[]): Option<int> {
  for x in xs { if x % 2 == 0 { return Option.Some(x); } }
  return Option.None;
}
fn quarter(n: int): Result<int> {
  let q = { let h = try half(n); let k = try half(h); k + 1 };
  return Result.Ok(q);
}
fn pick(xs: int[]): Option<int> {
  let v = { try first_even(xs); 100 };
  let w = { let (a, b) = try Option.Some((v, 2)); a * b };
  return Option.Some(w);
}
for n in [8, 6, 3] {
  match quarter(n) { Ok(v) => print("ok", v), Err(m) => print("err", m) }
}
print(pick([1, 3, 4]), pick([1, 3]));
