fn main() {
  let xs = [1e21, 1e-7, 123456789.123, 0.1 + 0.2, 1.0 / 3.0, 100.0, 1e15, 1e16, 2.5e-5, 123456789012345678.0, 0.000001];
  for x in xs { print(x); }
  print(float(9007199254740991), int(1e15), -0.0);
  print(sqrt(2.0), floor(-2.5), ceil(-2.5));
  print(parse_float("1e3", 0.0), parse_int("9007199254740991", 0), parse_int("9007199254740992", -1));
}
main();
