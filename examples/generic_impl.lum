struct Stack<T> { items: T[] }

impl<T> Stack<T> {
  fn new(first: T): Stack<T> {
    return Stack { items: [first] };
  }
  fn push(self, x: T) {
    push(self.items, x);
  }
  fn pop(self): T {
    return pop(self.items);
  }
  fn size(self): int {
    return len(self.items);
  }
}

enum Option<T> { Some(T), None }

impl<T> Option<T> {
  fn unwrap_or(self, d: T): T {
    match self {
      Some(v) => { return v; }
      None => { return d; }
    }
  }
  fn is_some(self): bool {
    match self {
      Some(_) => { return true; }
      None => { return false; }
    }
  }
}

let s = Stack.new(1);
s.push(2);
s.push(3);
print(s.size());
print(s.pop() + s.pop());
let names = Stack.new("a");
names.push("b");
print(names);

let o: Option<int> = Option.Some(5);
let n: Option<int> = Option.None;
print(o.unwrap_or(0) + n.unwrap_or(10));
print(o.is_some());
print(n.is_some());
