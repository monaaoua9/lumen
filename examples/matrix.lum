// nested arrays: a grid, matrix multiply, jagged rows, arrays of structs inside arrays
struct P { x: int }

fn zeros(n: int, m: int): int[][] {
  let rows: int[][] = [];
  for _ in 0..n {
    let row: int[] = [];
    for _ in 0..m { push(row, 0); }
    push(rows, row);
  }
  return rows;
}

fn mul(a: int[][], b: int[][]): int[][] {
  let out = zeros(len(a), len(b[0]));
  for i in 0..len(a) {
    for j in 0..len(b[0]) {
      for k in 0..len(b) {
        out[i][j] += a[i][k] * b[k][j];
      }
    }
  }
  return out;
}

let a = [[1, 2], [3, 4]];
let b = [[5, 6], [7, 8]];
print(mul(a, b));

let grid = zeros(2, 3);
grid[1][2] = 9;
grid[0][0] = grid[1][2] + 1;
print(grid);
print(len(grid) * len(grid[0]));

let jagged = [[1], [2, 3], []];
push(jagged[2], 4);
push(jagged, [5, 6, 7]);
print(jagged);

let names = [["ada", "bob"], ["eve"]];
print(names[0][1] + names[1][0]);

let ps = [[P { x: 1 }], [P { x: 2 }, P { x: 3 }]];
ps[1][0].x += 10;
print(ps);

let cube = [[[1, 2], [3]], [[4]]];
print(cube[0][1][0] + cube[1][0][0]);
print(cube);
